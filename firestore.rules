rules_version = '2';

// ============================================================
// Hub Totali · regras do banco
// ------------------------------------------------------------
// Cole isto na aba REGRAS do Firestore, no console do Firebase,
// e clique em Publicar.
//
// O UID abaixo já é o do administrador do Hub (Raoni), copiado do
// Authentication → aba Users. Para trocar de administrador, é aqui
// e em js/config-hub.js — nos dois lugares.
//
// O que estas regras dizem, em português:
//
//   LER  — qualquer um pode. É proposital: a lista de links do
//          Hub é pública de qualquer jeito, já que a página fica
//          no ar aberta. Não há nada aqui que não pudesse estar
//          escrito num cartaz na parede.
//
//   ESCREVER — só o administrador, e só no documento hub/config.
//          Todo o resto do banco fica trancado para todo mundo.
//
// Por isso a regra é a única proteção que importa: se um dia ela
// for afrouxada, qualquer pessoa na internet passa a poder
// reescrever a página inicial de toda a equipe.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    match /hub/config {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == 'UMBvjqMpw2bEbpvBIZnhE5iwlB23';
    }

    // Nada mais neste banco é acessível por ninguém.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
