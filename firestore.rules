rules_version = '2';

// ============================================================
// Hub Totali · regras do banco
// ------------------------------------------------------------
// Cole na aba REGRAS do Firestore, no console do Firebase, e
// clique em Publicar. Depois de qualquer mudança aqui, publique
// de novo — o arquivo desta pasta é só a cópia.
//
// ------------------------------------------------------------
// A IDEIA CENTRAL, EM UMA FRASE
// ------------------------------------------------------------
// Ter conta no Firebase não dá acesso a nada. O que dá acesso é
// estar na LISTA DA EQUIPE, e essa lista só o administrador
// escreve.
//
// Isso não é preciosismo. Com a chave pública que fica visível
// na página, qualquer pessoa da internet consegue criar uma
// conta no projeto — isso não dá para desligar sem servidor
// próprio. Então a conta não pode valer nada por si só. Quem
// criar uma por fora entra numa tela vazia.
//
// ------------------------------------------------------------
// ANEXOS
// ------------------------------------------------------------
// Uma pendência passou a poder carregar arquivos. Eles moram no
// Storage — ver storage.rules, que é outro arquivo e outra
// publicação — e o que fica aqui é só a ficha de cada um.
//
// Qualquer pessoa da equipe acrescenta. Ninguém tira: a regra
// exige que a lista nova seja pelo menos do tamanho da antiga.
//
// ------------------------------------------------------------
// O QUE MUDOU EM 08/09/2026, MAIS TARDE
// ------------------------------------------------------------
// A REGRA DE hub/config PASSOU A VALER PARA hub/{doc}. Apareceram
// documentos irmãos — a cópia de antes do último Salvar, e os
// ícones separados — e todos obedecem ao mesmo: equipe lê,
// administrador escreve.
//
// ------------------------------------------------------------
// O QUE MUDOU EM 08/09/2026
// ------------------------------------------------------------
// EXISTE MAIS DE UM ADMINISTRADOR. Antes a alçada era um UID
// escrito nesta regra: para dar acesso de administração a alguém
// era preciso editar e publicar isto aqui — exatamente o tipo de
// coisa que este sistema foi feito para não precisar. Agora ela
// vem do campo "papel" do cadastro da pessoa, que se troca pela
// tela.
//
// O fundador continua por UID, porque alguém precisa ser o
// primeiro, e o cadastro dele passou a ser intocável por outro
// administrador — senão o convidado poderia desligar o anfitrião.
//
// ------------------------------------------------------------
// O QUE MUDOU EM 04/09/2026
// ------------------------------------------------------------
// A LISTA DE SISTEMAS DEIXOU DE SER PÚBLICA. Era lida por
// qualquer um de propósito, para o Hub abrir sem login. Passou a
// exigir estar na equipe, junto com a tela de entrada do Hub e a
// retirada da cópia que ficava em js/sistemas.js.
//
// ------------------------------------------------------------
// O QUE MUDOU NA AUDITORIA DE 02/09/2026
// ------------------------------------------------------------
// A versão anterior deixava quatro brechas, todas na alteração
// de pendência:
//
//   1. A SITUAÇÃO NÃO ERA VALIDADA NA ALTERAÇÃO. Era só na
//      criação. Dava para gravar situação com qualquer texto e
//      quebrar o agrupamento da tela de todo mundo.
//
//   2. O RESPONSÁVEL PODIA TROCAR O RESPONSÁVEL. Ou seja:
//      empurrar a tarefa para outra pessoa sem ninguém saber.
//
//   3. O RESPONSÁVEL PODIA MUDAR O PRÓPRIO PRAZO. Uma pendência
//      atrasada deixava de estar atrasada por decisão de quem
//      estava devendo.
//
//   4. NÃO HAVIA LIMITE DE TAMANHO nos campos longos. Um
//      documento de quase um mega por pendência é caro de ler e
//      lento de abrir para a equipe inteira.
//
// A correção segue um princípio: cada pessoa muda o que é do
// papel dela. Quem faz mexe na SITUAÇÃO, que é o trabalho dela.
// Quem abriu mexe no PEDIDO, e só nos primeiros trinta minutos.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- atalhos ----------

    function autenticado() {
      return request.auth != null;
    }

    // O FUNDADOR é por UID, escrito aqui. Não é preferência: antes
    // de existir lista de equipe não há de onde tirar um primeiro
    // administrador, e sem ele ninguém escreveria a lista. É o nó
    // que se desata por fora.
    function fundador() {
      return autenticado()
             && request.auth.uid == 'UMBvjqMpw2bEbpvBIZnhE5iwlB23';
    }

    function meuCadastro() {
      return get(/databases/$(database)/documents/equipe/$(request.auth.uid)).data;
    }

    function daEquipe() {
      return autenticado()
             && exists(/databases/$(database)/documents/equipe/$(request.auth.uid))
             && meuCadastro().ativo == true;
    }

    // OS DEMAIS ADMINISTRADORES saem do campo "papel" do próprio
    // cadastro. Assim a alçada se dá e se tira pela tela, sem
    // ninguém editar regra nem publicar nada.
    function ehAdmin() {
      return fundador() || (daEquipe() && meuCadastro().papel == 'admin');
    }

    // QUEM É DA GERÊNCIA. Serve para uma coisa só: mexer nos
    // recados do Hub sem poder mexer na lista de sistemas.
    //
    // O NOME "Gerência" ESTÁ ESCRITO AQUI, e isso amarra a regra a
    // um texto que a administração pode renomear. Por isso a tela
    // de setores se recusa a renomear ou remover este — e a de
    // Diretoria, que o código das pendências reservadas também usa
    // como chave. Renomear em silêncio tiraria acesso de gente sem
    // ninguém entender por quê.
    function ehGerencia() {
      return daEquipe()
             && 'setores' in meuCadastro()
             && meuCadastro().setores is list
             && 'Gerência' in meuCadastro().setores;
    }

    function meuUid(uid) {
      return autenticado() && request.auth.uid == uid;
    }

    // HORA DE AGORA. Toda janela de trinta minutos conta a partir
    // de uma hora gravada no documento — e essa hora vinha do
    // relógio de quem gravava, sem conferência nenhuma. Um comentário
    // criado com data em 2100 ficava corrigível e apagável até 2100.
    // A tela nunca fez isso; bastava chamar o banco direto.
    //
    // O Hub agora grava com a hora do SERVIDOR (== request.time).
    // A tolerância de dez minutos é para uma aba que ficou aberta
    // com a versão anterior, que ainda manda a hora do computador:
    // ela continua conseguindo gravar, e o máximo que ganha são dez
    // minutos a mais de janela.
    function horaDeAgora(t) {
      return t is timestamp
             && (t == request.time
                 || (t > request.time - duration.value(10, 'm')
                     && t < request.time + duration.value(10, 'm')));
    }

    // Quais campos a alteração encostou. É o que permite dizer
    // "esta pessoa só pode mexer NAQUELE campo".
    function mudou() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function textoAte(campo, limite) {
      return !(campo in request.resource.data)
             || (request.resource.data[campo] is string
                 && request.resource.data[campo].size() <= limite);
    }

    // ---------- a lista de sistemas do Hub ----------
    // ANTES esta leitura era aberta, para o Hub abrir sem login.
    // Agora é privada: o Hub tem tela de entrada e só desenha
    // depois dela.
    //
    // Fechar aqui só valeu porque a cópia da lista saiu de
    // js/sistemas.js no mesmo movimento. Aquele arquivo é servido
    // pela web — o repositório é público — e enquanto a lista
    // estivesse lá, esta regra seria enfeite: bastava abrir o
    // endereço do .js.

    // {doc} em vez de "config": a mesma regra passa a valer para
    // todos os documentos desta gaveta. São três hoje —
    //
    //   config    a lista de sistemas e os recados
    //   anterior  a cópia de antes do último Salvar, para desfazer
    //   logos     os ícones, que saíram de config por serem 85% do
    //             peso e quase nunca mudarem
    //
    // — e a regra é a mesma para os três: quem é da equipe lê,
    // só o administrador escreve. Repetir o bloco por documento
    // seria três lugares para esquecer de mudar um.
    match /hub/{doc} {
      allow read:  if daEquipe() || ehAdmin();
      allow write: if ehAdmin();
    }

    // ---------- a equipe ----------
    // Quem está na equipe vê os colegas: sem isso não daria para
    // escolher para quem mandar uma pendência. Escrever, só o
    // administrador.
    //
    // O documento guarda nome, e-mail, setores e ativo. NUNCA
    // senha: a senha vive no Authentication, que é outro sistema,
    // e nem o administrador consegue lê-la.
    //
    // A validação de forma existe porque o campo "ativo" é o que
    // a função daEquipe() consulta para liberar TUDO. Se uma
    // gravação errada trocasse ele por texto, a comparação
    // silenciosamente viraria falsa e a equipe inteira perderia
    // acesso sem ninguém entender por quê.

    // ---------- os recados e prazos ----------
    // MORAM FORA DO hub/config, e o motivo é de alçada. Estavam
    // dentro dele, junto da lista de sistemas — e o documento
    // inteiro é de administrador. Para a Gerência poder escrever um
    // recado sem poder reescrever os quarenta e tantos links da
    // casa, o recado precisou de documento próprio.
    //
    // Esta regra CONVIVE com a de /hub/{doc} acima: o Firestore
    // libera se QUALQUER regra liberar. A de cima já dá escrita ao
    // administrador; esta acrescenta a Gerência, e só aqui.
    match /hub/avisos {
      allow read:  if daEquipe();
      allow write: if (ehAdmin() || ehGerencia())
                      && request.resource.data.json is string
                      && request.resource.data.json.size() <= 20000;
    }

    // ---------- os favoritos de cada pessoa ----------
    // Um documento por pessoa, com o nome do documento sendo o uid
    // dela. A regra é curta porque a pergunta é curta: é seu? então
    // é sua. Ninguém lê nem escreve o de ninguém — nem o
    // administrador, e isso é de propósito: favorito não é dado de
    // trabalho, é preferência, e não há motivo para a casa olhar.
    //
    // O TAMANHO É LIMITADO porque este é o único lugar do sistema
    // onde a pessoa comum escreve texto livre num documento só
    // dela. Sem teto, uma aba aberta com um laço maluco encheria o
    // banco da casa.
    match /favoritos/{uid} {
      allow read: if meuUid(uid) && daEquipe();
      // APAGAR VEM SEPARADO DE ESCREVER, e não por preciosismo: num
      // apagamento não existe request.resource, então uma condição
      // sobre ele nunca é verdadeira. Com tudo junto em "write", o
      // DELETE voltava 403 — medido, não suposto.
      allow delete: if meuUid(uid) && daEquipe();
      // O TETO SUBIU porque o ícone de cada link próprio é guardado
      // aqui dentro, como imagem embutida. A conta do pior caso:
      // trinta links, cada um com nome, endereço e uma imagem de
      // até 9 KB, dá algo perto de 280 KB. O limite do Firestore
      // para um documento é 1 MiB, então ainda sobra folga — e o
      // teto continua existindo para que uma aba enlouquecida não
      // encha o banco da casa.
      allow create, update: if meuUid(uid) && daEquipe()
                      && request.resource.data.json is string
                      && request.resource.data.json.size() <= 300000;
    }

    match /equipe/{uid} {
      allow read: if daEquipe() || ehAdmin();

      // O CADASTRO DO FUNDADOR só ele escreve. Sem isto, um
      // administrador novo poderia desligar quem lhe deu a alçada
      // e ficar sozinho com a chave. Ele continua administrador de
      // qualquer jeito, porque fundador() é por UID — mas ficaria
      // fora da equipe, e sem pendências.
      allow write: if ehAdmin()
                   && (uid != 'UMBvjqMpw2bEbpvBIZnhE5iwlB23' || fundador())
                   && request.resource.data.ativo is bool
                   && request.resource.data.nome is string
                   && request.resource.data.nome.size() <= 120
                   && request.resource.data.email is string
                   && request.resource.data.email.size() <= 200
                   && (!('papel' in request.resource.data)
                       || request.resource.data.papel in ['equipe', 'admin'])
                   && (!('setores' in request.resource.data)
                       || request.resource.data.setores is list);
    }

    // ---------- pendências ----------

    match /pendencias/{id} {

      allow read: if daEquipe();

      allow create: if daEquipe()
                    && meuUid(request.resource.data.criadoPor)
                    && horaDeAgora(request.resource.data.criadoEm)
                    && request.resource.data.oque is string
                    && request.resource.data.oque.size() > 2
                    && request.resource.data.oque.size() <= 300
                    && request.resource.data.responsavel is string
                    // PESSOA, SETOR OU CIÊNCIA — um dos três. Nem
                    // sempre se sabe quem vai fazer, e obrigar a
                    // escolher um nome faz a pessoa chutar um colega.
                    //
                    // A TERCEIRA FORMA É O RECADO COM CIÊNCIA: não tem
                    // responsável nem setor de destino porque não é
                    // tarefa de ninguém — é um aviso que cada nome da
                    // lista precisa confirmar que leu. Sem esta
                    // cláusula a regra recusaria justamente o caso
                    // que ela não previa.
                    && (request.resource.data.responsavel.size() > 0
                        || (request.resource.data.setorDestino is string
                            && request.resource.data.setorDestino.size() > 0)
                        // A TERCEIRA FORMA É UM CAMPO, E NÃO O TAMANHO DE
                        // UMA LISTA. Antes eu exigia gente na lista de
                        // ciência para reconhecer um recado — e isso
                        // recusava o recado que a pessoa escreve para si
                        // mesma, sem ninguém a confirmar. A natureza
                        // passou a ser declarada, e o tamanho da lista
                        // virou só validação.
                        || request.resource.data.ehRecado == true)
                    && (!('deveDarCiencia' in request.resource.data)
                        || (request.resource.data.deveDarCiencia is list
                            && request.resource.data.deveDarCiencia.size() <= 60))

                    && request.resource.data.situacao in ['aberta', 'fazendo', 'resolvida']
                    && (!('envolvidos' in request.resource.data)
                        || request.resource.data.envolvidos is list)
                    && textoAte('porque', 2000)
                    && textoAte('sugestao', 2000)
                    && (!('urgencia' in request.resource.data)
                        || request.resource.data.urgencia in ['urgente', 'normal', 'quando_der'])
                    && textoAte('prazo', 10)
                    && textoAte('setorOrigem', 60)
                    && textoAte('setorDestino', 60);

      // Quem criou e quando são imutáveis para sempre: são eles
      // que sustentam a trilha. Se pudessem ser reescritos, o
      // histórico deixaria de ser prova.
      //
      // Depois disso, cada um mexe no que é do papel dele.
      allow update: if daEquipe()
                    && request.resource.data.criadoPor == resource.data.criadoPor
                    && request.resource.data.criadoEm == resource.data.criadoEm
                    && request.resource.data.situacao in ['aberta', 'fazendo', 'resolvida']
                    && (
                         // MARCA DE LEITURA. Qualquer um da equipe
                         // se acrescenta à lista de quem já abriu a
                         // ficha, e a lista não encolhe.
                         //
                         // Aqui a comparação de tamanho BASTA, ao
                         // contrário do que acontecia com os anexos.
                         // Anexo é prova, e prova precisa de
                         // imutabilidade de verdade — por isso foi
                         // para uma subcoleção. Marca de leitura é
                         // conveniência: o pior que alguém consegue
                         // adulterando isto é aparecer como quem
                         // não leu.
                         (mudou().hasOnly(['vistas'])
                          && request.resource.data.vistas is list
                          && request.resource.data.vistas.size() <= 60
                          && (!('vistas' in resource.data)
                              || request.resource.data.vistas.size() >= resource.data.vistas.size()))

                         // CIÊNCIA É OUTRA COISA QUE A MARCA DE
                         // LEITURA, e por isso é outro campo.
                         //
                         // "vistas" é marcado sozinho quando alguém
                         // abre o cartão: serve para destacar o que
                         // ainda não se leu, e o pior que uma
                         // adulteração faz é a pessoa aparecer como
                         // quem não leu. Por isso a regra dele se
                         // contenta em conferir que a lista cresceu.
                         //
                         // "ciencia" é ato deliberado e serve de
                         // prova: alguém clicou dizendo "eu li e
                         // estou ciente". Prova frouxa não é prova —
                         // se desse para pôr o nome de um colega,
                         // não valeria nada. Então aqui não basta
                         // crescer: o que ENTROU tem de ser só o uid
                         // de quem está escrevendo. Ninguém dá
                         // ciência por ninguém, nem sem querer.
                         // TRÊS CONDIÇÕES, E CADA UMA FECHA UM BURACO
                         // QUE UM TESTE ENCONTROU:
                         //
                         // hasAll(antiga) — a lista NÃO PODE PERDER
                         // ninguém. Sem isto, bastava mandar uma lista
                         // vazia: removeAll de nada é nada, e "nada"
                         // satisfaz hasOnly. A regra barrava assinar
                         // pelo colega e deixava APAGAR a assinatura
                         // dele — que estraga a prova pelo outro lado.
                         // Medi: HTTP 200 onde devia ser 403.
                         //
                         // removeAll(antiga).hasOnly([uid]) — o que
                         // ENTROU só pode ser o próprio nome. É o que
                         // impede assinar por outro.
                         //
                         // uid in nova — quem escreve está na lista.
                         // Sem isto, uma escrita que não acrescenta
                         // nada passaria sem dizer a quem serve.
                         || (mudou().hasOnly(['ciencia'])
                             && request.resource.data.ciencia is list
                             && request.resource.data.ciencia.size() <= 60
                             && request.auth.uid in request.resource.data.ciencia
                             && (('ciencia' in resource.data)
                                 ? (request.resource.data.ciencia
                                      .hasAll(resource.data.ciencia)
                                    && request.resource.data.ciencia
                                      .removeAll(resource.data.ciencia)
                                      .hasOnly([request.auth.uid]))
                                 : request.resource.data.ciencia
                                     .hasOnly([request.auth.uid])))

                         // QUEM FAZ mexe só na situação. Não troca o
                         // responsável (empurrar tarefa sem avisar) nem
                         // o prazo (deixar de estar atrasado por
                         // decisão de quem está devendo).
                         // QUEM FAZ, ou QUEM É DO SETOR de destino
                         // quando a pendência não tem dono: alguém
                         // do Fiscal precisa poder dizer "peguei".
                         || ((meuUid(resource.data.responsavel)
                              || (resource.data.responsavel == ''
                                  && resource.data.setorDestino in meuCadastro().setores))
                             && mudou().hasOnly(['situacao']))

                         // QUEM ABRIU pode fechar a qualquer momento, e
                         // corrigir o pedido nos primeiros trinta
                         // minutos — depois disso, ajuste vira
                         // comentário na linha do tempo.
                         // MENOS A CIÊNCIA. A janela de trinta minutos
                         // existe para corrigir um pedido escrito com
                         // pressa, e antes dela não havia campo que
                         // fosse prova. Agora há: sem esta exceção,
                         // quem abre um recado poderia escrever a
                         // ciência dos colegas nos primeiros trinta
                         // minutos — e confirmação que o remetente
                         // fabrica não confirma nada. Medi: quatro
                         // tentativas de assinar por outro passaram, e
                         // passaram por aqui. Corrigir o texto do
                         // recado segue liberado; assinar por outro,
                         // não.
                         || (meuUid(resource.data.criadoPor)
                             && !mudou().hasAny(['ciencia'])
                             && (
                              mudou().hasOnly(['situacao'])
                              || request.time < resource.data.criadoEm + duration.value(30, 'm')
                            ))

                         // AQUI HAVIA a permissão de mexer no campo
                         // "anexos", com a lista nova obrigada a ser
                         // pelo menos do tamanho da antiga. Isso
                         // impede a lista ENCOLHER e não impede
                         // reescrever uma entrada que já está lá —
                         // eu tinha comentado como se fosse
                         // imutabilidade, e não era.
                         //
                         // Os anexos foram para uma subcoleção, do
                         // mesmo jeito que a linha do tempo, onde
                         // cada um é um documento que só pode ser
                         // criado. Aí a imutabilidade é de verdade,
                         // e não uma comparação de tamanho.
                       );

      // Apagar: só quem abriu. Responsável resolve, não some com
      // a cobrança.
      allow delete: if daEquipe() && meuUid(resource.data.criadoPor);

      // ---------- os anexos ----------
      // Um documento por arquivo, criado e nunca mais tocado. A
      // mesma forma da linha do tempo, e pelo mesmo motivo: o que
      // serve de prova não pode ser reescrito por quem tem
      // interesse no que ela prova.
      //
      // O arquivo em si vive no Storage — ver storage.rules. O que
      // está aqui é a ficha dele.
      match /anexos/{item} {
        allow read:   if daEquipe();
        // Apagar a FICHA do anexo, só quem abriu a pendência — e a
        // regra do Storage exige o mesmo para o arquivo. Os dois
        // saem juntos ou não sai nenhum, e o que some é sempre a
        // pendência inteira.
        allow delete: if daEquipe() && meuUid(get(/databases/$(database)/documents/pendencias/$(id)).data.criadoPor);
        allow create: if daEquipe()
                      && meuUid(request.resource.data.por)
                      && request.resource.data.nome is string
                      && request.resource.data.nome.size() > 0
                      && request.resource.data.nome.size() <= 200
                      && request.resource.data.caminho is string
                      && request.resource.data.caminho.size() <= 400
                      && request.resource.data.tamanho is int
                      && request.resource.data.tamanho <= 10485760;

        // APAGAR O ANEXO DEIXANDO A MARCA, nos primeiros trinta
        // minutos e só por quem mandou.
        //
        // NÃO É UM DELETE: a ficha fica, com quem mandou, o nome do
        // arquivo e a hora em que foi apagado. O arquivo mesmo sai
        // do Storage, e o "caminho" vira vazio para ninguém tentar
        // abrir o que não existe mais.
        //
        // Substituir continua impossível: não há forma aceita aqui
        // que troque nome, tamanho ou caminho por outro conteúdo.
        //
        // Ficha antiga não tem "criadoEm" — nasceram antes do
        // campo. Sem hora não há janela para medir, então elas
        // seguem saindo só com a pendência inteira.
        allow update: if daEquipe()
                      && meuUid(resource.data.por)
                      && resource.data.get('apagado', false) != true
                      && 'criadoEm' in resource.data
                      && request.time < resource.data.criadoEm + duration.value(30, 'm')
                      && mudou().hasOnly(['apagado', 'apagadoEm', 'caminho'])
                      && request.resource.data.apagado == true
                      && request.resource.data.caminho == ''
                      && horaDeAgora(request.resource.data.apagadoEm);
      }

      // ---------- a linha do tempo ----------

      match /andamento/{item} {
        allow read:   if daEquipe();
        allow create: if daEquipe()
                      && meuUid(request.resource.data.autor)
                      && horaDeAgora(request.resource.data.criadoEm)
                      && request.resource.data.texto is string
                      && request.resource.data.texto.size() > 0
                      && request.resource.data.texto.size() <= 3000
                      && textoAte('autorNome', 120);

        // JANELA DE ARREPENDIMENTO: trinta minutos para corrigir
        // o que você mesmo escreveu. Depois fecha para sempre,
        // inclusive para o administrador.
        //
        // Autor e data continuam travados mesmo dentro da janela:
        // dá para mudar o texto, não quem escreveu nem quando. O
        // prazo serve para erro de digitação, não para reescrever
        // a história depois que o colega leu e respondeu.
        //
        // DOIS JEITOS DE MEXER DENTRO DA JANELA, e só esses dois:
        //
        //  · CORRIGIR: troca o texto por outro texto.
        //
        //  · APAGAR DEIXANDO A MARCA: o texto vira vazio e o item
        //    ganha apagado = true e a hora. O texto se perde de
        //    verdade — o banco não guarda versão anterior —, mas a
        //    linha do tempo continua mostrando que ali havia um
        //    comentário, de quem e quando. Sumir sem rastro faria a
        //    resposta de um colega ficar falando sozinha.
        //
        // Item já apagado não volta nem muda mais. Registro do
        // sistema não entra em nenhum dos dois (o get() com padrão
        // cobre os comentários antigos, de antes do campo).
        allow update: if daEquipe()
                      && meuUid(resource.data.autor)
                      && resource.data.get('doSistema', false) != true
                      && resource.data.get('apagado', false) != true
                      && request.time < resource.data.criadoEm + duration.value(30, 'm')
                      && ((mudou().hasOnly(['texto', 'editadoEm'])
                           && request.resource.data.texto is string
                           && request.resource.data.texto.size() > 0
                           && request.resource.data.texto.size() <= 3000)
                          || (mudou().hasOnly(['texto', 'apagado', 'apagadoEm'])
                              && request.resource.data.texto == ''
                              && request.resource.data.apagado == true
                              && horaDeAgora(request.resource.data.apagadoEm)));

        // APAGAR, SÓ JUNTO COM A PENDÊNCIA INTEIRA — e por quem a
        // abriu.
        //
        // O "nunca" de antes protegia a coisa certa: ninguém
        // reescreve nem some com o que o colega escreveu ENQUANTO
        // a conversa está de pé. Só que ele também deixava a linha
        // do tempo órfã no banco quando a pendência era apagada —
        // comentários invisíveis, sem nada que os explicasse.
        //
        // A permissão nova é a mesma dos anexos, e é estreita
        // pelas mesmas razões: só quem ABRIU a pendência, e só
        // ENQUANTO ELA EXISTE. O get() abaixo falha depois de ela
        // sumir, então a janela se fecha sozinha.
        //
        //
        // Apagar UM comentário dentro da janela não passa por aqui:
        // é o update lá em cima, que deixa a marca. Um delete de
        // verdade permitiria sumir sem rastro chamando o banco por
        // fora da tela.
        allow delete: if daEquipe()
                      && meuUid(get(/databases/$(database)/documents/pendencias/$(id)).data.criadoPor);
      }
    }

    // ============================================================
    // PENDÊNCIAS RESERVADAS
    // ------------------------------------------------------------
    // Mesma coisa das outras, com uma diferença: quem lê precisa
    // estar em podemVer — as partes, a gerência, a diretoria e os
    // administradores, gravados na criação.
    //
    // COLEÇÃO SEPARADA, e não um campo "confidencial" na coleção
    // de sempre. A primeira tentativa foi campo, e quebrou por um
    // motivo do Firestore que só apareceu no teste: para listar,
    // ele exige que a consulta seja provadamente segura contra a
    // regra. Consulta sem filtro vira 403 — não devolve o que
    // pode, recusa tudo. E filtrar por "confidencial == false" não
    // alcança documento onde o campo não existe, o que sumiu com
    // toda pendência criada antes da mudança.
    //
    // Com a coleção separada, a de sempre volta a ter regra que
    // não olha conteúdo — lista sem filtro, documento antigo
    // continua visível — e a reservada é consultada filtrando por
    // podemVer, que todo documento de lá tem por construção.
    // ============================================================
    match /pendencias_reservadas/{id} {

      allow read: if daEquipe() && request.auth.uid in resource.data.podemVer;

      allow create: if daEquipe()
                    && meuUid(request.resource.data.criadoPor)
                    && horaDeAgora(request.resource.data.criadoEm)
                    && request.resource.data.podemVer is list
                    && request.resource.data.podemVer.size() > 0
                    && request.resource.data.podemVer.size() <= 60
                    // Quem cria precisa estar na lista. Sem isto,
                    // dava para abrir uma reservada e não poder
                    // mais lê-la — inclusive sem querer.
                    && request.auth.uid in request.resource.data.podemVer
                    && request.resource.data.oque is string
                    && request.resource.data.oque.size() > 2
                    && request.resource.data.oque.size() <= 300
                    && request.resource.data.situacao in ['aberta', 'fazendo', 'resolvida']
                    && textoAte('porque', 2000)
                    && textoAte('sugestao', 2000)
                    && textoAte('prazo', 10)
                    && textoAte('setorOrigem', 60)
                    && textoAte('setorDestino', 60);

      allow update: if daEquipe()
                    && request.auth.uid in resource.data.podemVer
                    && request.resource.data.criadoPor == resource.data.criadoPor
                    && request.resource.data.criadoEm == resource.data.criadoEm
                    && request.resource.data.podemVer == resource.data.podemVer
                    && request.resource.data.situacao in ['aberta', 'fazendo', 'resolvida']
                    && (
                         (mudou().hasOnly(['vistas'])
                          && request.resource.data.vistas is list
                          && request.resource.data.vistas.size() <= 60)

                         // CIÊNCIA É OUTRA COISA QUE A MARCA DE
                         // LEITURA, e por isso é outro campo.
                         //
                         // "vistas" é marcado sozinho quando alguém
                         // abre o cartão: serve para destacar o que
                         // ainda não se leu, e o pior que uma
                         // adulteração faz é a pessoa aparecer como
                         // quem não leu. Por isso a regra dele se
                         // contenta em conferir que a lista cresceu.
                         //
                         // "ciencia" é ato deliberado e serve de
                         // prova: alguém clicou dizendo "eu li e
                         // estou ciente". Prova frouxa não é prova —
                         // se desse para pôr o nome de um colega,
                         // não valeria nada. Então aqui não basta
                         // crescer: o que ENTROU tem de ser só o uid
                         // de quem está escrevendo. Ninguém dá
                         // ciência por ninguém, nem sem querer.
                         // TRÊS CONDIÇÕES, E CADA UMA FECHA UM BURACO
                         // QUE UM TESTE ENCONTROU:
                         //
                         // hasAll(antiga) — a lista NÃO PODE PERDER
                         // ninguém. Sem isto, bastava mandar uma lista
                         // vazia: removeAll de nada é nada, e "nada"
                         // satisfaz hasOnly. A regra barrava assinar
                         // pelo colega e deixava APAGAR a assinatura
                         // dele — que estraga a prova pelo outro lado.
                         // Medi: HTTP 200 onde devia ser 403.
                         //
                         // removeAll(antiga).hasOnly([uid]) — o que
                         // ENTROU só pode ser o próprio nome. É o que
                         // impede assinar por outro.
                         //
                         // uid in nova — quem escreve está na lista.
                         // Sem isto, uma escrita que não acrescenta
                         // nada passaria sem dizer a quem serve.
                         || (mudou().hasOnly(['ciencia'])
                             && request.resource.data.ciencia is list
                             && request.resource.data.ciencia.size() <= 60
                             && request.auth.uid in request.resource.data.ciencia
                             && (('ciencia' in resource.data)
                                 ? (request.resource.data.ciencia
                                      .hasAll(resource.data.ciencia)
                                    && request.resource.data.ciencia
                                      .removeAll(resource.data.ciencia)
                                      .hasOnly([request.auth.uid]))
                                 : request.resource.data.ciencia
                                     .hasOnly([request.auth.uid])))
                         || (meuUid(resource.data.responsavel) && mudou().hasOnly(['situacao']))
                         // MENOS A CIÊNCIA. A janela de trinta minutos
                         // existe para corrigir um pedido escrito com
                         // pressa, e antes dela não havia campo que
                         // fosse prova. Agora há: sem esta exceção,
                         // quem abre um recado poderia escrever a
                         // ciência dos colegas nos primeiros trinta
                         // minutos — e confirmação que o remetente
                         // fabrica não confirma nada. Medi: quatro
                         // tentativas de assinar por outro passaram, e
                         // passaram por aqui. Corrigir o texto do
                         // recado segue liberado; assinar por outro,
                         // não.
                         || (meuUid(resource.data.criadoPor)
                             && !mudou().hasAny(['ciencia'])
                             && (
                              mudou().hasOnly(['situacao'])
                              || request.time < resource.data.criadoEm + duration.value(30, 'm')
                            ))
                       );

      allow delete: if daEquipe() && meuUid(resource.data.criadoPor);

      match /anexos/{item} {
        allow read:   if daEquipe() && request.auth.uid in get(/databases/$(database)/documents/pendencias_reservadas/$(id)).data.podemVer;
        allow create: if daEquipe() && meuUid(request.resource.data.por);
        allow delete: if daEquipe() && meuUid(get(/databases/$(database)/documents/pendencias_reservadas/$(id)).data.criadoPor);
        // Mesma marca de apagado das pendências comuns — ver lá.
        allow update: if daEquipe()
                      && meuUid(resource.data.por)
                      && resource.data.get('apagado', false) != true
                      && 'criadoEm' in resource.data
                      && request.time < resource.data.criadoEm + duration.value(30, 'm')
                      && mudou().hasOnly(['apagado', 'apagadoEm', 'caminho'])
                      && request.resource.data.apagado == true
                      && request.resource.data.caminho == ''
                      && horaDeAgora(request.resource.data.apagadoEm);
      }

      match /andamento/{item} {
        allow read:   if daEquipe() && request.auth.uid in get(/databases/$(database)/documents/pendencias_reservadas/$(id)).data.podemVer;
        allow create: if daEquipe()
                      && meuUid(request.resource.data.autor)
                      && horaDeAgora(request.resource.data.criadoEm)
                      && request.resource.data.texto is string
                      && request.resource.data.texto.size() > 0
                      && request.resource.data.texto.size() <= 3000;
        // Mesmos dois caminhos das pendências comuns — ver lá.
        allow update: if daEquipe()
                      && meuUid(resource.data.autor)
                      && resource.data.get('doSistema', false) != true
                      && resource.data.get('apagado', false) != true
                      && request.time < resource.data.criadoEm + duration.value(30, 'm')
                      && ((mudou().hasOnly(['texto', 'editadoEm'])
                           && request.resource.data.texto is string
                           && request.resource.data.texto.size() > 0
                           && request.resource.data.texto.size() <= 3000)
                          || (mudou().hasOnly(['texto', 'apagado', 'apagadoEm'])
                              && request.resource.data.texto == ''
                              && request.resource.data.apagado == true
                              && horaDeAgora(request.resource.data.apagadoEm)));
        allow delete: if daEquipe()
                      && meuUid(get(/databases/$(database)/documents/pendencias_reservadas/$(id)).data.criadoPor);
      }
    }

    // Nada mais neste banco é acessível por ninguém.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
